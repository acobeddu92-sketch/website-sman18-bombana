# Database connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Secret for Session Authentication
JWT_SECRET="your-32-character-or-longer-jwt-secret-key"

# Node Environment ("development" | "production")
NODE_ENV="development"

# Vercel Blob Storage Token (disediakan otomatis oleh Vercel saat integrasi Blob Store dibuat di dashboard Vercel)
# Untuk pengujian lokal yang terhubung ke Vercel Blob, salin token dari Vercel dashboard:
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxx"
